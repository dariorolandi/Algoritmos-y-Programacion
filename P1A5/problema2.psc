// Convertir grados Celsius a Kelvin y a Fahrenheit

Algoritmo ConversionTemperatura
	Definir celsius, kelvin, fahrenheit Como Real
	
	Escribir "Ingresa la temperatura en grados Celsius"
	Leer celsius
	
	kelvin <- celsius + 273
	fahrenheit <- (celsius * 9 / 5) + 32
	
	Escribir "La temperatura en Kelvin es: ", kelvin
	Escribir "La temperatura en Fahrenheit es: ", fahrenheit
FinAlgoritmo


	

